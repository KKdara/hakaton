# auto: vector search if API credentials are set, otherwise local BM25 search.
SEARCH_MODE=auto
LLM_BASE_URL=
LLM_API_KEY=
EMB_MODEL=BAAI/bge-m3
CHROMA_DIR=data/chroma_db
CHROMA_COLLECTION=legal_docs
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATES=30
RETRIEVAL_EXCLUDE_OUTDATED=true
RERANK_ENABLED=false
RERANK_MODEL=Qwen/Qwen3-Reranker-8B
RERANK_BASE_URL=
RERANK_API_KEY=
# Initial retrieval thresholds; calibrate on the team's test questions.
VEC_HIGH=0.45
VEC_LOW=0.30
RERANK_HIGH=0.70
RERANK_LOW=0.30
